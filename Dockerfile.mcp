FROM python:3.12-slim
WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV MCP_PORT=8001
ENV BACKEND_URL=http://app:3000

# Install dependencies
COPY server/requirements-mcp.txt ./
RUN pip install --no-cache-dir -r requirements-mcp.txt

# Copy server code
COPY server/fastmcp_server.py ./

EXPOSE 8001

CMD ["python", "fastmcp_server.py"]
