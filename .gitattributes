# Shell scripts run on Linux (EC2, containers): keep LF even on Windows checkouts.
*.sh text eol=lf

# Flutter / Android boilerplate: keep it out of the GitHub language statistics.
# (Generated by Flutter on every build, or the standard Gradle wrapper.)
flutter_app/android/app/src/main/java/** linguist-generated
flutter_app/android/gradlew linguist-vendored
flutter_app/android/gradlew.bat linguist-vendored
flutter_app/android/gradle/** linguist-vendored
flutter_app/pubspec.lock linguist-generated
